# Application Settings
APP_NAME="Money Exchange & Accounting System"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="change-this-in-production-use-a-strong-secret-key-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Settings
# For Docker / Local Postgres: postgresql://postgres:postgres@localhost:5432/money_exchange_db
# For Local Dev without local Postgres daemon: sqlite:///./money_exchange.db
DATABASE_URL="sqlite:///./money_exchange.db"

# Company Base & Foreign Currencies
BASE_CURRENCY="BDT"
PRIMARY_FOREIGN_CURRENCY="MYR"
TIMEZONE="Asia/Dhaka"

# Financial Precision
CURRENCY_DECIMAL_PLACES=2
RATE_DECIMAL_PLACES=4
QUANTITY_DECIMAL_PLACES=4
